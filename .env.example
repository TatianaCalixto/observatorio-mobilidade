# ===== Observatório de Mobilidade — variáveis de ambiente =====
# Copie este arquivo para `.env` e ajuste os valores. O `.env` NÃO é versionado.

# --- Recorte temporal do projeto (OBRIGATÓRIO) ---
# Últimos 12 meses; aplicado a clima, série de viagens/atrasos e split temporal do ML.
DATA_INICIO=2025-06-01
DATA_FIM=2026-05-31

# --- Caminhos (opcionais; defaults derivados da raiz do repositório) ---
# DATA_DIR=./data
# DUCKDB_PATH=./mobilidade.duckdb

# --- URLs/identificadores das fontes ---
# GTFS SPTrans (feed estático). Mirror público do Mobility Database (sem token) — DEC-005.
# O feed oficial da SPTrans exige token; este mirror re-hospeda a versão mais recente.
GTFS_SPTRANS_URL=https://storage.googleapis.com/storage/v1/b/mdb-latest/o/br-sao-paulo-sao-paulo-transporte-sptrans-gtfs-8.zip?alt=media
# INMET (clima) — usa o portal de dados históricos (zip anual); estação A701 (SP) — DEC-003.
INMET_BASE_URL=
# IBGE/SIDRA (população) — base da API SIDRA; tabela 4714 Censo 2022 — DEC-004.
SIDRA_BASE_URL=https://apisidra.ibge.gov.br
